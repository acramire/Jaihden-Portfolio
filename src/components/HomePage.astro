---
import {
  bioOptimization,
  cta,
  goalOptions,
  heroSlides,
  mission,
  navItems,
  proof,
  qualification,
  resources,
  site,
  socialLinks,
  whatYouGet,
} from '../data/site';

const fratleteHref = resources.fratleteUrl || site.social.instagram;

const applyHref = site.integrations.tallyUrl || '#apply';
const bookHref = site.integrations.calendlyUrl || applyHref;
const stickyHref = bookHref;

// Inline line-icons (stroke = currentColor).
const icons: Record<string, string> = {
  apple:
    '<path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"/><path d="M10 2c1 .5 2 2 2 5"/>',
  dumbbell:
    '<path d="M6 7v10"/><path d="M9 5v14"/><path d="M15 5v14"/><path d="M18 7v10"/><path d="M9 12h6"/>',
  target:
    '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',
  loop:
    '<path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/>',
  moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  spark:
    '<path d="M12 3v4"/><path d="M12 17v4"/><path d="M3 12h4"/><path d="M17 12h4"/><path d="M12 8a4 4 0 0 0 4 4 4 4 0 0 0-4 4 4 4 0 0 0-4-4 4 4 0 0 0 4-4Z"/>',
  phone:
    '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M10 5.5h4"/><path d="M9.5 9.5h5"/><path d="M9.5 12.5h5"/><path d="M9.5 15.5h3"/>',
};

const svg = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name] ?? ''}</svg>`;

const arrowLeft =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>';
const arrowRight =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>';

// "Apply" is the CTA button; "Proof" hides until there is a real testimonial.
const visibleNav = navItems.filter((item) => {
  if (item.href === '#apply') return false;
  if (item.href === '#proof') return proof.length > 0;
  return true;
});
---

<header class="site-header" data-type-style="anton">
  <a class="brand-mark" href="#top" aria-label="Jaihden Torres home">Jaihden Torres</a>
  <button
    class="nav-toggle"
    type="button"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="primary-nav"
    data-nav-toggle
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
  <nav id="primary-nav" aria-label="Primary navigation" data-nav data-open="false">
    {visibleNav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a class="header-cta" href={applyHref} data-cta="header-apply">Apply</a>
</header>

<main id="top" data-type-style="anton">
  <!-- 1. HERO CAROUSEL ------------------------------------------------------ -->
  <section class="hero-carousel" aria-label="Jaihden Torres coaching highlights" id="hero">
    <h1 class="sr-only">
      Jaihden Torres — lifestyle-first fitness coaching and Pump University.
    </h1>
    <div class="hc-track" data-hc-track>
      {
        heroSlides.map((slide, index) => (
          <article
            class="hc-slide"
            data-hc-slide
            data-slide-kind={slide.kind}
            data-slide-id={slide.id}
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${heroSlides.length}`}
          >
            <img class="hc-slide__img" src={slide.image} alt={slide.alt} loading={index === 0 ? 'eager' : 'lazy'} />
            {slide.id === 'youtube' && (
              <a
                class="hc-youtube-play"
                href={site.social.youtube}
                aria-label="Watch Jaihden Torres on YouTube"
                data-cta="slide-youtube-play"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
              </a>
            )}
            <div class="hc-slide__shade" />
            <div class="hc-slide__content">
              <p class="eyebrow">{slide.eyebrow}</p>
              <h2 class="hc-slide__title">{slide.title}</h2>

              {slide.kind === 'questionnaire' ? (
                <div class="quiz" data-quiz>
                  <div class="quiz__step" data-quiz-step="1">
                    <div class="quiz__progress">
                      <span class="quiz__progress-label">Start here</span>
                      <span class="quiz__progress-count">Step 1 of 2</span>
                    </div>
                    <h3 class="quiz__question">What is your main goal right now?</h3>
                    <div class="quiz__bar" aria-hidden="true">
                      <span style="width: 50%" />
                    </div>
                    <div class="quiz__options" role="group" aria-label="Choose your goal">
                      {goalOptions.map((opt) => (
                        <button
                          type="button"
                          class="quiz__option"
                          data-quiz-goal={opt.value}
                          data-quiz-label={opt.label}
                          data-quiz-tally-value={opt.tallyValue}
                        >
                          <strong>{opt.label}</strong>
                        </button>
                      ))}
                    </div>
                  </div>

                  <div class="quiz__step" data-quiz-step="2" hidden>
                    <div class="quiz__progress">
                      <span class="quiz__progress-label">
                        Goal: <em data-quiz-chosen>Your goal</em>
                      </span>
                      <span class="quiz__progress-count">Step 2 of 2</span>
                    </div>
                    <div class="quiz__bar" aria-hidden="true">
                      <span style="width: 100%" />
                    </div>
                    <p class="quiz__confirm">
                      Perfect. Start the short questionnaire and, if it’s a fit, you’ll book a call —
                      no pressure to commit before then.
                    </p>
                    <div class="quiz__actions">
                      <a class="button button-primary" href={applyHref} data-quiz-apply data-cta="quiz-apply">
                        Continue to application
                      </a>
                      <a class="button button-secondary" href={bookHref} data-cta="quiz-book">
                        {cta.stickyLabel}
                      </a>
                    </div>
                    <button type="button" class="quiz__back" data-quiz-back>← Change goal</button>
                  </div>
                </div>
              ) : (
                <Fragment>
                  {slide.body && <p class="hc-slide__body">{slide.body}</p>}
                  <div class="hc-slide__actions">
                    {slide.id === 'pump' ? (
                      <a class="button button-secondary" href={site.social.shop} data-cta="slide-shop">
                        Shop Pump University
                      </a>
                    ) : slide.id === 'youtube' ? (
                      <a class="button button-secondary" href={site.social.youtube} data-cta="slide-youtube">
                        Watch on YouTube
                      </a>
                    ) : (
                      <a class="button button-primary" href={applyHref} data-cta="slide-apply">
                        {cta.applyLabel}
                      </a>
                    )}
                  </div>
                </Fragment>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <button class="hc-arrow hc-arrow--prev" type="button" aria-label="Previous slide" data-hc-prev set:html={arrowLeft} />
    <button class="hc-arrow hc-arrow--next" type="button" aria-label="Next slide" data-hc-next set:html={arrowRight} />

    <div class="hc-dots" role="tablist" aria-label="Choose slide" data-hc-dots>
      {
        heroSlides.map((_, index) => (
          <button
            type="button"
            class="hc-dot"
            role="tab"
            aria-label={`Go to slide ${index + 1}`}
            data-hc-dot={index}
          />
        ))
      }
    </div>
  </section>

  <!-- 2. TESTIMONIALS ------------------------------------------------------- -->
  <section class="testimonials section-light" id="proof">
    <div class="section-heading">
      <p class="eyebrow">Proof</p>
      <h2>{proof.length > 0 ? 'Real results from real clients.' : 'Real results, added as they happen.'}</h2>
    </div>
    {proof.length > 0 ? (
      <div class="proof-grid">
        {proof.map((item) => (
          <article class="proof-card">
            {item.image && <img src={item.image} alt={`Result from ${item.name}`} />}
            <p class="proof-quote">“{item.quote}”</p>
            <span>{item.detail ? `${item.name} · ${item.detail}` : item.name}</span>
          </article>
        ))}
      </div>
    ) : (
      <div class="testimonials-empty">
        <p>
          Client transformations are featured here as they're approved — no stock
          photos, no invented quotes. Want yours on this wall? Apply and be one of
          the first.
        </p>
        <a class="button button-primary" href={applyHref} data-cta="proof-apply">
          Apply to get featured
        </a>
      </div>
    )}
  </section>

  <!-- 3. WHO THIS IS FOR / ISN'T -------------------------------------------- -->
  <section class="fit section-dark" id="fit">
    <div class="section-heading">
      <p class="eyebrow">The fit</p>
      <h2>Who this is for. Who it isn't.</h2>
    </div>
    <div class="fit-grid">
      <article class="fit-card fit-card--yes">
        <h3>{qualification.yes.title}</h3>
        <ul>
          {qualification.yes.items.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="fit-card fit-card--no">
        <h3>{qualification.no.title}</h3>
        <ul>
          {qualification.no.items.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <!-- 4. WHAT DO YOU GET (slider) ------------------------------------------- -->
  <section class="get section-light" id="get">
    <div class="get-head">
      <div>
        <p class="eyebrow">What do you get?</p>
        <h2>Premium 1-on-1 coaching, built around you.</h2>
      </div>
      <div class="get-nav">
        <button class="get-arrow" type="button" aria-label="Previous benefit" data-get-prev set:html={arrowLeft} />
        <span class="get-count" data-get-count>1 / {whatYouGet.length}</span>
        <button class="get-arrow" type="button" aria-label="Next benefit" data-get-next set:html={arrowRight} />
      </div>
    </div>
    <div class="get-track" data-get-track>
      {
        whatYouGet.map((item) => (
          <article class="get-card" data-get-card>
            <div class="get-card__top">
              <span class="get-card__icon" set:html={svg(item.icon)} />
              {item.tag && <span class="get-card__tag">{item.tag}</span>}
            </div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
    <a class="button button-primary get-cta" href={applyHref} data-cta="get-apply">{cta.applyLabel}</a>
  </section>

  <!-- 5. BIO-OPTIMIZATION TOOLS --------------------------------------------- -->
  <section class="bio section-dark" id="bio">
    <div class="bio-media">
      <img src={site.media.bioOptimization} alt="" loading="lazy" />
    </div>
    <div class="bio-copy">
      <p class="eyebrow">{bioOptimization.eyebrow}</p>
      <h2>{bioOptimization.title}</h2>
      <p class="bio-lead">{bioOptimization.body}</p>
      <ul class="bio-points">
        {bioOptimization.points.map((point) => (
          <li>
            <span class="bio-points__icon" set:html={svg('moon')} />
            <span>{point}</span>
          </li>
        ))}
      </ul>
      <a class="bio-resource" href={fratleteHref} data-cta="bio-fratlete">
        <span class="bio-resource__label">Bio-optimization resources</span>
        <span class="bio-resource__code">Code <strong>{resources.fratleteCode}</strong></span>
        <span class="bio-resource__arrow" set:html={arrowRight} />
      </a>
    </div>
  </section>

  <!-- 6. MISSION / GET TO KNOW ME ------------------------------------------- -->
  <section class="story section-dark" id="story">
    <div class="story-media">
      <a href={site.social.youtube} aria-label="Watch Jaihden Torres on YouTube">
        <img src={site.media.story} alt="Jaihden Torres portrait" loading="lazy" />
        <span class="play-badge">▶ {mission.videoLabel}</span>
      </a>
    </div>
    <div class="story-copy">
      <p class="eyebrow">{mission.eyebrow}</p>
      <h2>{mission.title}</h2>
      <p class="bio-lead">{mission.body}</p>
      <div class="story-actions">
        <a class="button button-secondary" href={site.social.youtube} data-cta="story-youtube">
          Watch on YouTube
        </a>
        <a class="button button-secondary" href={site.social.storyVideo} data-cta="story-feature">
          Beer Tastes Better With Abs
        </a>
      </div>
    </div>
  </section>

  <!-- 7. PUMP UNIVERSITY BRAND BAND ----------------------------------------- -->
  <section class="pump-university section-dark" id="pump-university">
    <div class="brand-image">
      <img src={site.media.pumpAthletes} alt="Pump University athletes in Trademark Collection apparel" loading="lazy" />
    </div>
    <div class="brand-copy">
      <p class="eyebrow">Co-equal brand pillar</p>
      <h2>Pump University: Look Great. Feel Better.</h2>
      <p class="bio-lead">
        The brand side of Jaihden's ecosystem: apparel, culture, and the same
        standard-driven lifestyle behind the coaching.
      </p>
      <div class="brand-actions">
        <a class="button button-primary" href={site.social.shop} data-cta="pump-shop">Shop Trademark Collection</a>
        <a class="button button-secondary" href={site.social.pumpUniversity} data-cta="pump-site">Visit Pump University</a>
      </div>
    </div>
  </section>

  <!-- 8. APPLY + SOCIAL ----------------------------------------------------- -->
  <section class="apply section-dark" id="apply">
    <div class="apply-panel">
      <p class="eyebrow">Apply</p>
      <h2>It's now or never.</h2>
      <p class="apply-hook">
        How long are you going to keep telling yourself you're going to change
        when you don't?
      </p>
      <p>
        Start with a few questions about your goals and schedule. If it's a fit,
        you'll book a 30-minute call — no pressure to commit before then.
      </p>
      <div class="apply-actions">
        <a class="button button-primary" href={applyHref} data-cta="apply-primary">{cta.applyLabel}</a>
        <a class="button button-secondary" href={bookHref} data-cta="apply-book">{cta.stickyLabel}</a>
      </div>
      <ul class="social-rail" aria-label="Follow Jaihden Torres">
        {
          socialLinks.map((link) => (
            <li>
              <a href={link.href} data-cta={`social-${link.label.toLowerCase()}`}>
                <strong>{link.label}</strong>
                <span>{link.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</main>

<!-- Sticky mobile CTA -->
<a class="sticky-cta" href={stickyHref} data-cta="sticky-book" data-sticky-cta>
  {cta.stickyLabel}
</a>

<footer>
  <span>Jaihden Torres</span>
  <span>Fitness coaching + Pump University</span>
  <a href="#top">Back to top</a>
</footer>

<script>
  // Manual rAF tween for horizontal paging. Direct scrollLeft writes per frame
  // work reliably with mandatory scroll-snap (CSS `scroll-behavior: smooth` and
  // scrollTo({behavior:'smooth'}) can be cancelled by the snap container).
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tweenScrollLeft = (el: HTMLElement, to: number, duration = 340) => {
    const target = Math.max(0, Math.min(el.scrollWidth - el.clientWidth, Math.round(to)));
    if (prefersReducedMotion || Math.abs(target - el.scrollLeft) < 2) {
      el.scrollLeft = target;
      return;
    }
    const start = el.scrollLeft;
    const startTime = performance.now();
    const ease = (p: number) => (p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2);
    const step = (now: number) => {
      const p = Math.min(1, (now - startTime) / duration);
      el.scrollLeft = start + (target - start) * ease(p);
      if (p < 1) requestAnimationFrame(step);
      else el.scrollLeft = target;
    };
    requestAnimationFrame(step);
  };

  // --- Mobile nav --------------------------------------------------------------
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.setAttribute('data-open', String(open));
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    };
    toggle.addEventListener('click', () => setOpen(nav.getAttribute('data-open') !== 'true'));
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }

  // --- Hero carousel -----------------------------------------------------------
  const track = document.querySelector<HTMLElement>('[data-hc-track]');
  if (track) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-hc-slide]'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-hc-dot]'));
    const prev = document.querySelector<HTMLButtonElement>('[data-hc-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-hc-next]');
    let active = 0;

    const setActive = (i: number) => {
      active = Math.max(0, Math.min(slides.length - 1, i));
      dots.forEach((dot, di) => dot.setAttribute('aria-selected', String(di === active)));
    };

    const goTo = (i: number) => {
      const clamped = Math.max(0, Math.min(slides.length - 1, i));
      tweenScrollLeft(track, clamped * track.clientWidth);
      setActive(clamped);
    };

    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
    prev?.addEventListener('click', () => goTo(active - 1));
    next?.addEventListener('click', () => goTo(active + 1));

    // Keep dots in sync with manual swiping.
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(slides.indexOf(entry.target as HTMLElement));
        });
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((slide) => io.observe(slide));
    setActive(0);
  }

  // --- Hero questionnaire ------------------------------------------------------
  const quiz = document.querySelector<HTMLElement>('[data-quiz]');
  if (quiz) {
    const step1 = quiz.querySelector<HTMLElement>('[data-quiz-step="1"]');
    const step2 = quiz.querySelector<HTMLElement>('[data-quiz-step="2"]');
    const chosen = quiz.querySelector<HTMLElement>('[data-quiz-chosen]');
    const applyLink = quiz.querySelector<HTMLAnchorElement>('[data-quiz-apply]');
    const baseApply = applyLink?.getAttribute('href') ?? '#apply';
    const buildApplicationHref = (value: string, label: string, tallyValue: string) => {
      if (!baseApply.startsWith('http')) return baseApply;
      const url = new URL(baseApply);
      url.searchParams.set('goal', value);
      url.searchParams.set('goal_label', label);
      // `main_goal` is the Tally handoff field; keep it aligned with the form.
      url.searchParams.set('main_goal', tallyValue || label);
      url.searchParams.set('source', 'website_quiz');
      return url.toString();
    };

    quiz.querySelectorAll<HTMLButtonElement>('[data-quiz-goal]').forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.getAttribute('data-quiz-goal') ?? '';
        const label = button.getAttribute('data-quiz-label') ?? '';
        const tallyValue = button.getAttribute('data-quiz-tally-value') ?? label;
        if (chosen) chosen.textContent = label;
        if (applyLink) applyLink.href = buildApplicationHref(value, label, tallyValue);
        step1?.setAttribute('hidden', '');
        step2?.removeAttribute('hidden');
      });
    });

    quiz.querySelector<HTMLButtonElement>('[data-quiz-back]')?.addEventListener('click', () => {
      step2?.setAttribute('hidden', '');
      step1?.removeAttribute('hidden');
    });
  }

  // --- "What do you get?" slider ----------------------------------------------
  const getTrack = document.querySelector<HTMLElement>('[data-get-track]');
  if (getTrack) {
    const cards = Array.from(getTrack.querySelectorAll<HTMLElement>('[data-get-card]'));
    const count = document.querySelector<HTMLElement>('[data-get-count]');
    const gPrev = document.querySelector<HTMLButtonElement>('[data-get-prev]');
    const gNext = document.querySelector<HTMLButtonElement>('[data-get-next]');
    let gActive = 0;

    const render = () => {
      if (count) count.textContent = `${gActive + 1} / ${cards.length}`;
    };
    const gGo = (i: number) => {
      gActive = Math.max(0, Math.min(cards.length - 1, i));
      const card = cards[gActive];
      // Center the card within the track without scrolling the page vertically.
      tweenScrollLeft(getTrack, card.offsetLeft - (getTrack.clientWidth - card.offsetWidth) / 2);
      render();
    };

    gPrev?.addEventListener('click', () => gGo(gActive - 1));
    gNext?.addEventListener('click', () => gGo(gActive + 1));

    const gio = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            gActive = cards.indexOf(entry.target as HTMLElement);
            render();
          }
        });
      },
      { root: getTrack, threshold: 0.6 },
    );
    cards.forEach((card) => gio.observe(card));
    render();
  }

  // --- Sticky CTA: reveal once past the hero -----------------------------------
  const sticky = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const heroSection = document.querySelector<HTMLElement>('#hero');
  if (sticky && heroSection) {
    const sio = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => sticky.classList.toggle('is-visible', !entry.isIntersecting));
      },
      { threshold: 0.15 },
    );
    sio.observe(heroSection);
  }
</script>
