---
import {
  cycleSteps,
  deliverables,
  featuredContent,
  methodPillars,
  navItems,
  proof,
  site,
  storyBeats,
} from '../data/site';

const applyHref = site.integrations.tallyUrl || '#apply';
const bookHref = site.integrations.calendlyUrl || '#apply';

// Inline line-icons (stroke = currentColor) for the expandable cards.
const icons: Record<string, string> = {
  apple:
    '<path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"/><path d="M10 2c1 .5 2 2 2 5"/>',
  dumbbell:
    '<path d="M6 7v10"/><path d="M9 5v14"/><path d="M15 5v14"/><path d="M18 7v10"/><path d="M9 12h6"/>',
  glass: '<path d="M4 4h16l-8 9z"/><path d="M12 13v7"/><path d="M8 21h8"/>',
  target:
    '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',
  moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  lock:
    '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  bolt: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  loop:
    '<path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/>',
};

const svg = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name] ?? ''}</svg>`;
const chevron =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';

// "Apply" is shown as the CTA button, not as a text link.
// "Proof" stays hidden until there is at least one approved testimonial.
const visibleNav = navItems.filter((item) => {
  if (item.href === '#apply') return false;
  if (item.href === '#proof') return proof.length > 0;
  return true;
});
---

<header
  class="site-header"
  data-type-style="anton"
  data-preview-slot="style.typeface"
  data-preview-attribute="data-type-style"
>
  <a class="brand-mark" href="#top" aria-label="Jaihden Torres home">Jaihden Torres</a>
  <button
    class="nav-toggle"
    type="button"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="primary-nav"
    data-nav-toggle
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
  <nav id="primary-nav" aria-label="Primary navigation" data-nav data-open="false">
    {visibleNav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a class="header-cta" href={applyHref} data-cta="header-apply" data-preview-slot="copy.cta.apply-short">
    Apply
  </a>
</header>

<main
  id="top"
  data-type-style="anton"
  data-preview-slot="style.typeface"
  data-preview-attribute="data-type-style"
>
  <section
    class="hero section-dark"
    data-hero-treatment="rule"
    data-preview-slot="style.heroTreatment"
    data-preview-attribute="data-hero-treatment"
  >
    <div class="hero-content">
      <p class="eyebrow hero-eyebrow" data-preview-slot="copy.hero.eyebrow">Fitness coaching + Pump University</p>
      <h1 data-preview-slot="copy.hero.headline">Real results without giving up your social life.</h1>
      <p class="hero-copy" data-preview-slot="copy.hero.body">
        Balanced, lifestyle-aware coaching for people who want to get leaner,
        stronger, and more confident while still living a full life.
      </p>
      <div class="hero-actions" aria-label="Primary calls to action">
        <a class="button button-primary" href={applyHref} data-cta="hero-apply" data-preview-slot="copy.cta.apply">
          Apply for Coaching
        </a>
        <a class="button button-secondary" href={site.social.shop} data-cta="hero-shop" data-preview-slot="copy.cta.shop">
          Shop Pump University
        </a>
      </div>
    </div>
    <div class="hero-media">
      <img
        src={site.media.transformationHero}
        alt="Jaihden Torres before and after fitness transformation"
        data-preview-slot="image.hero"
      />
    </div>
    <dl
      class="hero-stats"
      aria-label="Experience and coaching paths"
      data-stat-treatment="glass-band"
      data-preview-slot="style.heroStats"
      data-preview-attribute="data-stat-treatment"
    >
      <div class="stat-feature">
        <dt>7+</dt>
        <dd>years lifting, learning, and building a lifestyle-first fitness standard.</dd>
      </div>
      <div class="stat-path">
        <dt>Fitness path</dt>
        <dd>Coaching built around training, nutrition, and social-life structure.</dd>
      </div>
      <div class="stat-path">
        <dt>Brand path</dt>
        <dd>Apparel, content, and lifestyle standards through Pump University.</dd>
      </div>
    </dl>
    <a class="hero-watch" href={site.social.storyVideo} data-cta="hero-story">
      <span class="hero-watch-icon" aria-hidden="true">▶</span>
      <span data-preview-slot="copy.cta.story">Watch the story</span>
    </a>
  </section>

  <section class="testimonials section-light" id="proof">
    <div class="section-heading">
      <p class="eyebrow">Proof</p>
      <h2>{proof.length > 0 ? 'Real results from real clients.' : 'Real results, added as they happen.'}</h2>
    </div>
    {proof.length > 0 ? (
      <div class="proof-grid">
        {proof.map((item) => (
          <article class="proof-card">
            {item.image && <img src={item.image} alt={`Result from ${item.name}`} />}
            <p class="proof-quote">“{item.quote}”</p>
            <span>{item.detail ? `${item.name} · ${item.detail}` : item.name}</span>
          </article>
        ))}
      </div>
    ) : (
      <div class="testimonials-empty">
        <p>
          Client transformations are featured here as they're approved — no stock
          photos, no invented quotes. Want yours on this wall? Apply and be one of
          the first.
        </p>
        <a class="button button-primary" href={applyHref} data-cta="proof-apply">
          Apply to get featured
        </a>
      </div>
    )}
  </section>

  <section class="problem section-light" id="problem">
    <div class="section-heading">
      <p class="eyebrow" data-preview-slot="copy.problem.eyebrow">The cycle</p>
      <h2 data-preview-slot="copy.problem.heading">Most plans fall apart the second real life starts.</h2>
    </div>
    <div class="problem-grid">
      {cycleSteps.map((step) => (
        <details class="xcard">
          <summary class="xcard__summary">
            <span class="xcard__icon" set:html={svg(step.icon)} />
            <span class="xcard__head">
              <span class="xcard__num">{step.number}</span>
              <h3 class="xcard__title">{step.title}</h3>
              <p class="xcard__teaser">{step.teaser}</p>
            </span>
            <span class="xcard__chevron" set:html={chevron} />
          </summary>
          <div class="xcard__body">
            <p>{step.text}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="method section-dark" id="method">
    <div class="section-heading">
      <p class="eyebrow" data-preview-slot="copy.method.eyebrow">The method</p>
      <h2 data-preview-slot="copy.method.heading">Five pillars built for the lifestyle you actually live.</h2>
    </div>
    <div class="pillar-grid">
      {methodPillars.map((pillar) => (
        <details class="xcard xcard--dark">
          <summary class="xcard__summary">
            <span class="xcard__icon" set:html={svg(pillar.icon)} />
            <span class="xcard__head">
              <span class="xcard__num">{pillar.number}</span>
              <h3 class="xcard__title">{pillar.title}</h3>
              <p class="xcard__teaser">{pillar.teaser}</p>
            </span>
            <span class="xcard__chevron" set:html={chevron} />
          </summary>
          <div class="xcard__body">
            <p>{pillar.text}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="deliverables section-light" id="deliverables">
    <div class="split">
      <div>
        <p class="eyebrow" data-preview-slot="copy.deliverables.eyebrow">What you get</p>
        <h2 data-preview-slot="copy.deliverables.heading">
          Clear structure before the call, during the week, and after the weekend.
        </h2>
        <p data-preview-slot="copy.deliverables.body">
          Everything is built around the life you actually live — training days,
          travel, recovery, and the weekends most plans pretend don't exist.
        </p>
      </div>
      <ul class="deliverable-list">
        {deliverables.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="story section-dark" id="story">
    <div class="story-media">
      <a href={site.social.storyVideo} aria-label="Watch Beer Tastes Better With Abs on YouTube">
        <img
          src={site.media.story}
          alt="Beer Tastes Better With Abs video thumbnail"
          data-preview-slot="image.story"
        />
        <span class="play-badge" data-preview-slot="copy.story.badge">Watch</span>
      </a>
    </div>
    <div class="story-copy">
      <p class="eyebrow" data-preview-slot="copy.story.eyebrow">Coach fit</p>
      <h2 data-preview-slot="copy.story.heading">Built from the same tension his clients are trying to solve.</h2>
      <div class="story-list">
        {storyBeats.map((beat) => (
          <article>
            <h3>{beat.title}</h3>
            <p>{beat.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pump-university section-dark" id="pump-university">
    <div class="brand-image">
      <img
        src={site.media.pumpUniversityHero}
        alt="Pump University Trademark Collection gym apparel"
        data-preview-slot="image.pumpUniversityHero"
      />
    </div>
    <div class="brand-copy">
      <p class="eyebrow" data-preview-slot="copy.pumpUniversity.eyebrow">Co-equal brand pillar</p>
      <h2 data-preview-slot="copy.pumpUniversity.heading">Pump University: Look Great. Feel Better.</h2>
      <p data-preview-slot="copy.pumpUniversity.body">
        Pump University is the brand side of Jaihden's ecosystem: apparel,
        culture, and the same standard-driven lifestyle behind the coaching.
      </p>
      <div class="brand-actions">
        <a class="button button-primary" href={site.social.shop} data-cta="pump-university-shop" data-preview-slot="copy.cta.shop-collection">
          Shop Trademark Collection
        </a>
        <a class="button button-secondary" href={site.social.pumpUniversity} data-cta="pump-university-site" data-preview-slot="copy.cta.pump-university-site">
          Visit Pump University
        </a>
      </div>
    </div>
  </section>

  <section class="content section-light" id="content">
    <div class="section-heading">
      <p class="eyebrow" data-preview-slot="copy.content.eyebrow">Content</p>
      <h2 data-preview-slot="copy.content.heading">Featured content without relying on fragile social embeds.</h2>
    </div>
    <div class="content-grid">
      {featuredContent.map((item) => (
        <a class="content-card" href={item.href} data-cta={`content-${item.title}`}>
          <img
            src={item.image}
            alt=""
            data-preview-slot={`image.content.${item.title.toLowerCase().replaceAll(' ', '-').replaceAll('+', 'and')}`}
          />
          <span>{item.label}</span>
          <h3>{item.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <section class="apply section-dark" id="apply">
    <div class="apply-panel">
      <p class="eyebrow" data-preview-slot="copy.apply.eyebrow">Apply</p>
      <h2 data-preview-slot="copy.apply.heading">Start with the questionnaire. Book after there is a fit.</h2>
      <p data-preview-slot="copy.apply.body">
        Start with a few questions about your goals and schedule. If it's a fit,
        you'll book a 30-minute call — no pressure to commit before then.
      </p>
      <div class="apply-actions">
        {
          site.integrations.tallyUrl ? (
            <a class="button button-primary" href={site.integrations.tallyUrl} data-cta="apply-tally" data-preview-slot="copy.cta.questionnaire">
              Start Questionnaire
            </a>
          ) : (
            <span class="button button-disabled" aria-disabled="true">
              Questionnaire link pending
            </span>
          )
        }
        {
          site.integrations.calendlyUrl ? (
            <a class="button button-secondary" href={bookHref} data-cta="apply-calendly" data-preview-slot="copy.cta.book">
              Book 30-Minute Call
            </a>
          ) : (
            <a class="button button-secondary" href={site.social.instagram} data-cta="apply-instagram">
              DM Jaihden on Instagram
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="contact section-light" id="contact">
    <div class="section-heading">
      <p class="eyebrow" data-preview-slot="copy.contact.eyebrow">Contact</p>
      <h2 data-preview-slot="copy.contact.heading">Coaching, brand, and content paths stay clear.</h2>
    </div>
    <div class="contact-grid">
      <a href={applyHref} data-cta="contact-apply">
        <span>Coaching</span>
        <strong>Apply for the coaching flow</strong>
      </a>
      <a href={site.social.shop} data-cta="contact-shop">
        <span>Pump University</span>
        <strong>Shop the Trademark Collection</strong>
      </a>
      <a href={site.social.instagram} data-cta="contact-instagram">
        <span>Social</span>
        <strong>Follow or DM on Instagram</strong>
      </a>
      <a href={site.social.youtube} data-cta="contact-youtube">
        <span>Video</span>
        <strong>Watch on YouTube</strong>
      </a>
    </div>
  </section>
</main>

<footer>
  <span>Jaihden Torres</span>
  <span>Fitness coaching + Pump University</span>
  <a href="#top">Back to top</a>
</footer>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.setAttribute('data-open', String(open));
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        open ? 'Close navigation menu' : 'Open navigation menu',
      );
    };

    toggle.addEventListener('click', () => {
      setOpen(nav.getAttribute('data-open') !== 'true');
    });

    // Close after picking a destination, or on Escape.
    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
