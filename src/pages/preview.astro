---
import HomePage from '../components/HomePage.astro';
import PreviewOverlay from '../components/PreviewOverlay.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const isDev = import.meta.env.DEV;
---

<BaseLayout title="Preview Scaffold | Jaihden Torres">
  {
    isDev ? (
      <>
        <HomePage />
        <PreviewOverlay />
      </>
    ) : (
      <main class="preview-unavailable">
        <h1>Preview unavailable</h1>
        <p>This route is a dev-only image and copy review tool.</p>
        <a class="button button-primary" href="/">Return home</a>
      </main>
    )
  }
</BaseLayout>

<style>
  .preview-unavailable {
    display: grid;
    min-height: 100vh;
    place-content: center;
    gap: 16px;
    padding: 24px;
    background: #0b0c0e;
    color: #fff;
    text-align: center;
  }

  .preview-unavailable h1 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(3rem, 9vw, 6rem);
    font-weight: 400;
    line-height: 0.95;
  }

  .preview-unavailable p {
    margin: 0 auto;
    max-width: 520px;
    color: rgba(255, 255, 255, 0.74);
  }

  .preview-unavailable .button {
    margin: 8px auto 0;
  }
</style>
