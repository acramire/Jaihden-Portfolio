---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  deliverables,
  featuredContent,
  methodPillars,
  navItems,
  proofPlaceholders,
  site,
  storyBeats,
} from '../data/site';

const applyHref = site.integrations.tallyUrl || '#apply';
const bookHref = site.integrations.calendlyUrl || '#apply';
---

<BaseLayout>
  <header class="site-header">
    <a class="brand-mark" href="#top" aria-label="Jaihden Torres home">
      <span>JT</span>
    </a>
    <nav aria-label="Primary navigation">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-cta" href={applyHref} data-cta="header-apply">Apply</a>
  </header>

  <main id="top">
    <section class="hero section-dark">
      <div class="hero-media" aria-hidden="true">
        <img src={site.media.hero} alt="" />
      </div>
      <div class="hero-content">
        <p class="eyebrow">Fitness coaching + UofPump</p>
        <h1>Real results without giving up your social life.</h1>
        <p class="hero-copy">
          Balanced, lifestyle-aware coaching for people who want to get leaner,
          stronger, and more confident while still living a full life.
        </p>
        <div class="hero-actions" aria-label="Primary calls to action">
          <a class="button button-primary" href={applyHref} data-cta="hero-apply">
            Apply for Coaching
          </a>
          <a class="button button-secondary" href={site.social.shop} data-cta="hero-shop">
            Shop UofPump
          </a>
          <a class="button button-ghost" href={site.social.storyVideo} data-cta="hero-story">
            Watch the Story
          </a>
        </div>
        <dl class="hero-stats" aria-label="Brand highlights">
          <div>
            <dt>7+</dt>
            <dd>years lifting</dd>
          </div>
          <div>
            <dt>2</dt>
            <dd>core pillars: coaching + brand</dd>
          </div>
          <div>
            <dt>1</dt>
            <dd>system built around real life</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="problem section-light" id="problem">
      <div class="section-heading">
        <p class="eyebrow">The cycle</p>
        <h2>Most plans fall apart the second real life starts.</h2>
      </div>
      <div class="problem-grid">
        <article>
          <span>01</span>
          <h3>Locked in all week</h3>
          <p>
            Training, eating clean, and trying to force progress with no plan
            for the weekend.
          </p>
        </article>
        <article>
          <span>02</span>
          <h3>The weekend hits</h3>
          <p>
            Drinks, travel, parties, dinners, and late nights turn into a full
            reset.
          </p>
        </article>
        <article>
          <span>03</span>
          <h3>Monday starts over</h3>
          <p>
            The goal is not to remove your social life. The goal is to build a
            system that survives it.
          </p>
        </article>
      </div>
    </section>

    <section class="method section-dark" id="method">
      <div class="section-heading">
        <p class="eyebrow">The method</p>
        <h2>Five pillars built for the lifestyle you actually live.</h2>
      </div>
      <div class="pillar-grid">
        {methodPillars.map((pillar) => (
          <article class="pillar-card">
            <span>{pillar.number}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="deliverables section-light" id="deliverables">
      <div class="split">
        <div>
          <p class="eyebrow">What you get</p>
          <h2>Clear structure before the call, during the week, and after the weekend.</h2>
          <p>
            This section is intentionally specific without publishing unconfirmed
            pricing, medical-adjacent claims, or support promises.
          </p>
        </div>
        <ul class="deliverable-list">
          {deliverables.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="story section-dark" id="story">
      <div class="story-media">
        <a href={site.social.storyVideo} aria-label="Watch Beer Tastes Better With Abs on YouTube">
          <img src={site.media.story} alt="Beer Tastes Better With Abs video thumbnail" />
          <span class="play-badge">Watch</span>
        </a>
      </div>
      <div class="story-copy">
        <p class="eyebrow">Coach fit</p>
        <h2>Built from the same tension his clients are trying to solve.</h2>
        <div class="story-list">
          {storyBeats.map((beat) => (
            <article>
              <h3>{beat.title}</h3>
              <p>{beat.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="proof section-light" id="proof">
      <div class="section-heading">
        <p class="eyebrow">Proof</p>
        <h2>Real quotes and transformations go here once approved.</h2>
        <p>
          No fabricated testimonials. These cards are ready for client-approved
          quotes, screenshots, and photos.
        </p>
      </div>
      <div class="proof-grid">
        {proofPlaceholders.map((proof) => (
          <article class="proof-card">
            <span>{proof.label}</span>
            <h3>{proof.title}</h3>
            <p>{proof.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="uofpump section-dark" id="uofpump">
      <div class="brand-image">
        <img src={site.media.uofpumpHero} alt="UofPump Trademark Collection gym apparel" />
      </div>
      <div class="brand-copy">
        <p class="eyebrow">Co-equal brand pillar</p>
        <h2>UofPump: Look Great. Feel Better.</h2>
        <p>
          Pump University is the brand side of Jaihden's ecosystem: apparel,
          culture, and the same standard-driven lifestyle behind the coaching.
        </p>
        <div class="brand-actions">
          <a class="button button-primary" href={site.social.shop} data-cta="uofpump-shop">
            Shop Trademark Collection
          </a>
          <a class="button button-secondary" href={site.social.uofpump} data-cta="uofpump-site">
            Visit UofPump
          </a>
        </div>
      </div>
    </section>

    <section class="content section-light" id="content">
      <div class="section-heading">
        <p class="eyebrow">Content</p>
        <h2>Featured content without relying on fragile social embeds.</h2>
      </div>
      <div class="content-grid">
        {featuredContent.map((item) => (
          <a class="content-card" href={item.href} data-cta={`content-${item.title}`}>
            <img src={item.image} alt="" />
            <span>{item.label}</span>
            <h3>{item.title}</h3>
          </a>
        ))}
      </div>
    </section>

    <section class="apply section-dark" id="apply">
      <div class="apply-panel">
        <p class="eyebrow">Apply</p>
        <h2>Start with the questionnaire. Book after there is a fit.</h2>
        <p>
          The v1 flow is built for a Tally application first, then Calendly for
          the 30-minute call once the final links are supplied.
        </p>
        <div class="apply-actions">
          {
            site.integrations.tallyUrl ? (
              <a class="button button-primary" href={site.integrations.tallyUrl} data-cta="apply-tally">
                Start Questionnaire
              </a>
            ) : (
              <span class="button button-disabled" aria-disabled="true">
                Questionnaire link pending
              </span>
            )
          }
          {
            site.integrations.calendlyUrl ? (
              <a class="button button-secondary" href={bookHref} data-cta="apply-calendly">
                Book 30-Minute Call
              </a>
            ) : (
              <a class="button button-secondary" href={site.social.instagram} data-cta="apply-instagram">
                DM Jaihden on Instagram
              </a>
            )
          }
        </div>
      </div>
    </section>

    <section class="contact section-light" id="contact">
      <div class="section-heading">
        <p class="eyebrow">Contact</p>
        <h2>Coaching, brand, and content paths stay clear.</h2>
      </div>
      <div class="contact-grid">
        <a href={applyHref} data-cta="contact-apply">
          <span>Coaching</span>
          <strong>Apply for the coaching flow</strong>
        </a>
        <a href={site.social.shop} data-cta="contact-shop">
          <span>UofPump</span>
          <strong>Shop the Trademark Collection</strong>
        </a>
        <a href={site.social.instagram} data-cta="contact-instagram">
          <span>Social</span>
          <strong>Follow or DM on Instagram</strong>
        </a>
        <a href={site.social.youtube} data-cta="contact-youtube">
          <span>Video</span>
          <strong>Watch on YouTube</strong>
        </a>
      </div>
    </section>
  </main>

  <footer>
    <span>Jaihden Torres</span>
    <span>Fitness coaching + UofPump</span>
    <a href="#top">Back to top</a>
  </footer>
</BaseLayout>
